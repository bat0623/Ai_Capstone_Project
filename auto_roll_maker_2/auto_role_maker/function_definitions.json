{
  "type": "function",
  "name": "generate_job_profile",
  "description": "판타지 직업 이름을 받아 요약, 전투 스타일, 말투, 사용 예시를 포함한 프로필을 JSON으로 반환합니다.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string",
        "description": "해당 직업에 대한 간략 설명"
      },
      "belongs_to": {
        "type": "string",
        "description": "해당 직업의 종족, 일반적으로는 '인간'"
      },
      "style_traits": {
        "type": "array",
        "minItems": 4,
        "maxItems": 6,
        "items": { "type": "string" },
        "description": "해당 직업과 해당 시대 말투의 핵심적 문체 특성"
      },
      "preferred_speech_patterns": {
        "type": "array",
        "minItems": 4,
        "maxItems": 6,
        "items": { "type": "string" },
        "description": "자주 쓰이는 문장 구조·표현 양식"
      },
      "typical_contexts": {
        "type": "array",
        "minItems": 4,
        "maxItems": 6,
        "items": { "type": "string" },
        "description": "해당 말투가 주로 쓰이는 상황"
      },
      "lexicon_notes": {
        "type": "array",
        "minItems": 4,
        "maxItems": 6,
        "items": { "type": "string" },
        "description": "해당 직업 및 시대의 어휘·표현의 키워드를 정리한 메타 정보"
      },
      "examples": {
        "type": "array",
        "minItems": 10,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "description": "대사 텍스트" },
            "tags": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "type": "string" },
              "description": "이 대사와 관련된 태그"
            },
            "intensity": { "type": "integer", "minimum": 1, "maximum": 5, "description": "말의 강도 (1~5)" }
          },
          "required": ["text", "tags", "intensity"]
        },
        "description": "대사 또는 활용 예시 목록"
      }
    },
    "required": [
      "summary",
      "belongs_to",
      "style_traits",
      "preferred_speech_patterns",
      "typical_contexts",
      "lexicon_notes",
      "examples"
    ]
  }
}
